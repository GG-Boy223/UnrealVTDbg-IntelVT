      <_Runtime Include="$(MSBuildThisFileDirectory)..\x64\$(Configuration)\Hook64.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\Hook64.dll')" />
      <_Runtime Include="$(MSBuildThisFileDirectory)..\Hook\x64\$(Configuration)\Hook64.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\Hook\x64\$(Configuration)\Hook64.dll')" />
      <_Runtime Include="$(MSBuildThisFileDirectory)..\x64\$(Configuration)\DbgkSysWin10.sys" Condition="Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\DbgkSysWin10.sys')" />
      <_Runtime Include="$(MSBuildThisFileDirectory)..\DbgkSysWin10\x64\$(Configuration)\DbgkSysWin10.sys" Condition="Exists('$(MSBuildThisFileDirectory)..\DbgkSysWin10\x64\$(Configuration)\DbgkSysWin10.sys')" />
      <_Runtime Include="$(MSBuildThisFileDirectory)..\x64\$(Configuration)\DbgkSysWin11.sys" Condition="Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\DbgkSysWin11.sys')" />
      <_Runtime Include="$(MSBuildThisFileDirectory)..\DbgkSysWin11\x64\$(Configuration)\DbgkSysWin11.sys" Condition="Exists('$(MSBuildThisFileDirectory)..\DbgkSysWin11\x64\$(Configuration)\DbgkSysWin11.sys')" />
      <_Runtime Include="$(MSBuildThisFileDirectory)..\x64\$(Configuration)\VT_Driver.sys" Condition="Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\VT_Driver.sys')" />
      <_Runtime Include="$(MSBuildThisFileDirectory)..\VT_Driver\x64\$(Configuration)\VT_Driver.sys" Condition="Exists('$(MSBuildThisFileDirectory)..\VT_Driver\x64\$(Configuration)\VT_Driver.sys')" />
      <_Runtime Include="$(MSBuildThisFileDirectory)..\x64\$(Configuration)\AIHelper.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\AIHelper.dll')" />
      <_Runtime Include="$(MSBuildThisFileDirectory)..\x64\$(Configuration)\VMProtectSDK64.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\VMProtectSDK64.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_Runtime)" DestinationFolder="$(OutDir)bin" SkipUnchangedFiles="true" Condition="'@(_Runtime)'!=''" />
    <ItemGroup>
      <_BinRuntime Include="$(OutDir)bin\*.dll;$(OutDir)bin\*.sys;$(OutDir)bin\*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_BinRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(_BinRuntime)'!=''" />
    <MakeDir Directories="$(OutDir)Symbols" />
    <Delete Files="$(OutDir)Symbols\DbgkSysWin10.pdb;$(OutDir)Symbols\DbgkSysWin11.pdb" />
    <MakeDir Directories="$(OutDir)Metadata" />
    <ItemGroup>
      <_LateSymbols Include="$(OutDir)*.pdb;$(OutDir)*.lib;$(OutDir)*.exp" />
      <_LateMetadata Include="$(OutDir)*.winmd;$(OutDir)*.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(_LateSymbols)" DestinationFolder="$(OutDir)Symbols" SkipUnchangedFiles="true" Condition="'@(_LateSymbols)'!=''" />
    <Copy SourceFiles="@(_LateMetadata)" DestinationFolder="$(OutDir)Metadata" SkipUnchangedFiles="true" Condition="'@(_LateMetadata)'!=''" />
    <Delete Files="@(_LateSymbols);@(_LateMetadata)" />
    <Delete Files="$(OutDir)Loader.exe;$(OutDir)虚幻调试器.exe;$(OutDir)bin\Loader.exe;$(OutDir)bin\虚幻调试器.exe" />
