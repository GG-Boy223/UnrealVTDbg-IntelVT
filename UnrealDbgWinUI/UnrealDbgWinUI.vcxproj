  <!--
    Runtime binaries are copied by StageRuntime when they already exist.
    They must not be ProjectReference entries: selecting UnrealDbgWinUI for
    rebuild must rebuild only the GUI, while a solution-wide build still
    builds every project independently.
  -->
  <Target Name="StageRuntime" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)bin;$(OutDir)Config;$(OutDir)Log;$(OutDir)Symbols;$(OutDir)Certificates" />
    <ItemGroup>
      <_Runtime Include="$(WindowsAppSDKPackageDir)runtimes\win-x64\native\Microsoft.WindowsAppRuntime.Bootstrap.dll" />
      <_Runtime Include="$(MSBuildThisFileDirectory)..\x64\$(Configuration)\UnrealDbgDll.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\UnrealDbgDll.dll')" />
